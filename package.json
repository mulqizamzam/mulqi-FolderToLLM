{
  "name": "mulqi-folder-to-llm",
  "version": "0.2.1-rc.2",
  "description": "DeepSeek Harness plugin for preparing filtered, privacy-aware project context snapshots from local workspaces, with beginner-friendly setup and reproducible output.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mulqizamzam"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills",
    "docs",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "submission"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node --test",
    "validate": "node scripts/validate.mjs",
    "check": "npm test && npm run validate"
  }
}